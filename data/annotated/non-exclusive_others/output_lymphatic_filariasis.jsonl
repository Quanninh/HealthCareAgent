{"pair_id": "PMC4349225_01::Lymphatic_Filariasis", "case_id": "PMC4349225_01", "target_disease": "Lymphatic_Filariasis", "decision": "INCONCLUSIVE_DATA", "dataset_label": "INCONCLUSIVE_DATA", "rationale": "A 52-year-old male from Burkina Faso presented with a 12-year history of massive penoscrotal elephantiasis (resected tissue weighed 12 kg). Clinicians made a clinical diagnosis of penoscrotal elephantiasis and administered antifilarial medications (albendazole and ivermectin). However, no E1 confirmatory parasitological tests (microscopy/PCR) or E2 antigen/antibody assays were performed or reported positive. Per protocol, clinical presentation and empirical treatment constitute E3-only supportive evidence, which is insufficient for a confirmed diagnosis, leading to an adjudication of INCONCLUSIVE_DATA.", "step1_doc_type": "CLINICAL_CASE_REPORT", "step1_document_type": "CLINICAL_CASE_REPORT", "step2_ccu_type": "PRIMARY_CARE_EPISODE", "step3_patient_anchor": "patient_1 (52yo male)", "step4_condition_matched": "Lymphatic_Filariasis", "step5_assertion": "SUSPECTED_POSSIBLE", "step5_concept_grounding": "TARGET_CONFIRMED", "step6_temporality": "CURRENT_EPISODE", "step7_clinical_role": "PRIMARY_DIAGNOSIS", "step8_case_definition": "SUSPECTED", "step9_evidence_strength": "E3_SUPPORTIVE", "step9_key_evidence": {"evidence_items": [{"source_field": "case_text", "start_char": 931, "end_char": 1115, "source_quote": "Looking at the epidemiological and clinical findings, we made a diagnosis of penoscrotal elephantiasis. The patient had taken a dose of anti filarial drugs (albendazol and ivermectin).", "patient_anchor_id": "patient_1", "test_name": "Clinical diagnosis and empirical treatment", "target_concept": "Penoscrotal elephantiasis", "specimen": null, "result": "SUSPECTED", "temporality": "CURRENT_EPISODE", "relation": "SUPPORTS", "strength": "E3_SUPPORTIVE"}]}, "step10_contradiction": "UNCONFIRMED_SUSPICION", "step10_contradiction_flag": true, "step11_vpd_satisfied": false, "step12_dataset_label": "INCONCLUSIVE_DATA", "step12_audit": {"annotator_id": "disease-agent-lymphatic_filariasis", "annotation_version": "1.0", "timestamp": "2026-11-04T04:42:28.238825+00:00", "confidence": "HIGH"}, "annotator_id": "disease-agent-lymphatic_filariasis", "annotation_version": "1.0", "confidence": "HIGH"}
{"pair_id": "PMC5579453_01::Lymphatic_Filariasis", "case_id": "PMC5579453_01", "target_disease": "Lymphatic_Filariasis", "decision": "EXCLUDED_NON_TARGET_CASE", "dataset_label": "EXCLUDED_NON_TARGET_CASE", "rationale": "A 35-year-old male developed encephalopathy and blindness after receiving ivermectin. Lymphatic filariasis is mentioned strictly in the abstract as background therapeutic context for ivermectin indication. Diagnostic evaluation for microfilariae in blood and CSF was explicitly negative, and the patient was diagnosed with post-ivermectin neurotoxicity. There is no active disease claim for lymphatic filariasis.", "step1_doc_type": "CLINICAL_CASE_REPORT", "step1_document_type": "CLINICAL_CASE_REPORT", "step2_ccu_type": "PRIMARY_CARE_EPISODE", "step3_patient_anchor": "patient_1 (35yo male)", "step4_condition_matched": "Lymphatic_Filariasis", "step5_assertion": "ABSENT_NEGATIVE", "step5_concept_grounding": "TARGET_CONFIRMED", "step6_temporality": "CURRENT_EPISODE", "step7_clinical_role": "EPIDEMIOLOGICAL_CONTEXT", "step8_case_definition": "NOT_MET", "step9_evidence_strength": "E4_CONTEXT", "step9_key_evidence": {"evidence_items": [{"source_field": "case_text", "start_char": 1916, "end_char": 2106, "source_quote": "The blood sample was collected in the morning of May 27th, 2016 for the research of microfilariae and dosage of anti-Acanthocheilonema vitae Immunoglobuline G and the results were negatives.", "patient_anchor_id": "patient_1", "test_name": "Blood examination for microfilariae", "target_concept": "Microfilariae", "specimen": "blood", "result": "NEGATIVE", "temporality": "CURRENT_EPISODE", "relation": "REFUTES", "strength": "E0_CONTRADICTED"}]}, "step10_contradiction": "BACKGROUND_DRUG_INDICATION", "step10_contradiction_flag": true, "step11_vpd_satisfied": false, "step12_dataset_label": "EXCLUDED_NON_TARGET_CASE", "step12_audit": {"annotator_id": "disease-agent-lymphatic_filariasis", "annotation_version": "1.0", "timestamp": "2026-11-04T04:42:28.2