{"pair_id": "PMC8075734_01::Lymphatic_Filariasis", "case_id": "PMC8075734_01", "target_disease": "Lymphatic_Filariasis", "decision": "EXCLUDED_NON_CASE_REPORT", "dataset_label": "EXCLUDED_NON_CASE_REPORT", "rationale": "This publication describes the institutional design and implementation of health postgraduate programs at Lúrio University in Mozambique. It is an educational case study of a university program without any individual human patient or clinical care episode. Lymphatic filariasis is mentioned only as provincial background epidemiology (12-13% prevalence in Nampula). Document type is non-clinical.", "step1_doc_type": "EXCLUDED_NON_CASE_REPORT", "step1_document_type": "EXCLUDED_NON_CASE_REPORT", "step2_ccu_type": "NON_CLINICAL_DOCUMENT", "step3_patient_anchor": "NO_PATIENT", "step4_condition_matched": "Lymphatic_Filariasis", "step5_assertion": "NOT_APPLICABLE", "step5_concept_grounding": "TARGET_CONFIRMED", "step6_temporality": "UNKNOWN", "step7_clinical_role": "EPIDEMIOLOGICAL_CONTEXT", "step8_case_definition": "NOT_MET", "step9_evidence_strength": "E4_CONTEXT", "step9_key_evidence": {"evidence_items": [{"source_field": "case_text", "start_char": 717, "end_char": 991, "source_quote": "Though neglected tropical diseases such as intestinal parasites (53%), lymphatic filariasis (13%), schistosomiasis (47%) are not direct causes of mortality, they lead to physical and mental disabilities in children and are correlated with anemia and malnutrition in general.", "patient_anchor_id": "none", "test_name": "Epidemiological survey citation", "target_concept": "Lymphatic filariasis prevalence", "specimen": null, "result": "EPIDEMIOLOGICAL_DATA", "temporality": "UNKNOWN", "relation": "REFUTES", "strength": "E4_CONTEXT"}]}, "step10_contradiction": "NON_CLINICAL_DOCUMENT", "step10_contradiction_flag": true, "step11_vpd_satisfied": false, "step12_dataset_label": "EXCLUDED_NON_CASE_REPORT", "step12_audit": {"annotator_id": "disease-agent-lymphatic_filariasis", "annotati