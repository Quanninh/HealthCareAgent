  <data key="d1">medication</data>
  <data key="d2">Isoniazid is a component of the RHEZ combination therapy for treating tuberculosis.</data>
  <data key="d3">chunk-165836f88e88091f092ccedc334c4381</data>
  <data key="d4">PMC_PMC5648305_01.json</data>
  <data key="d5">1790441222</data>
