<node id="Guillain-Barré Syndrome">
  <data key="d0">Guillain-Barré Syndrome</data>
  <data key="d1">disease</data>
  <data key="d2">Guillain-Barré Syndrome is an acute immune-mediated demyelinating disease characterized by progressive, ascending, symmetrical flaccid paralysis with or without cranial nerve involvement.</data>
  <data key="d3">chunk-ac7c9d342e29c1d5d1cce632be77bcf0</data>
  <data key="d4">PMC_PMC7687474_01.json</data>
  <data key="d5">1790442525</data>
  <data key="d6"></data>
</node>
<node id="Mao et al.">
  <data key="d0">Mao et al.</data>
  <data key="d1">patient_cohort</data>
  <data key="d2">Mao et al. reported 36.4% of study participants hospitalized with COVID-19 had neurological manifestations.</data>
  <data key="d3">chunk-ac7c9d342e29c1d5d1cce632be77bcf0</data>
  <data key="d4">PMC_PMC7687474_01.json</data>
  <data key="d5">1790442525</data>
  <data key="d6"></data>
</node>
<node id="40.0%">
  <data key="d0">40.0%</data>
  <data key="d1">symptom</data>
  <data key="d2">40% of the 214 study participants hospitalized with COVID-19 had neurological symptoms, as reported by Mao et al.</data>
  <data key="d3">chunk-ac7c9d342e29c1d5d1cce632be77bcf0</data>
  <data key="d4">PMC_PMC7687474_01.json</data>
  <data key="d5">1790442525</data>
  <data key="d6"></data>
</node>
<node id="Italy">
  <data key="d0">Italy</data>
  <data key="d1">location</data>
  <data key="d2">Four patients in Italy experienced lower limb weakness and paresthesia initially with one patient developing facial diplegia and ataxia within 5-10 days of symptoms of COVID-19.</data>
  <data key="d3">chunk-ac7c9d342e29c1d5d1cce632be77bcf0</data>
  <data key="d4">PMC_PMC7687474_01.json</data>
  <data key="d5">1790442525</data>
  <data key="d6"></data>
</node>
