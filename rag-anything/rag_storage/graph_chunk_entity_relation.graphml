<node id="Acid-Fast Staining">
  <data key="d0">Acid-Fast Staining</data>
  <data key="d1">diagnostic_test</data>
  <data key="d2">Acid-fast staining is a laboratory test performed on synovial fluid to detect acid-fast bacilli.</data>
  <data key="d3">chunk-aacfc6d7d3cc205cac72c8b8558bd157</data>
  <data key="d4">PMC_PMC8184239_01.json</data>
