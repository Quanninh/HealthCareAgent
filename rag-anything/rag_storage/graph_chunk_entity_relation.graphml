  <data key="d1">symptom</data>
  <data key="d2">Muscle atrophy and contracture are chronic complications of leprosy affecting peripheral nerves.</data>
  <data key="d3">chunk-94513ac90298144829224f0a47c2e282</data>
  <data key="d4">PMC_PMC8184239_01.json</data>
  <data key="d5">1790440797</data>
