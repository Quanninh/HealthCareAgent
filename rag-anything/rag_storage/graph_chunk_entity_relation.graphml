  <data key="d0">Mycobacterium Leprae</data>
  <data key="d1">pathogen</data>
  <data key="d2">Mycobacterium Leprae is the causative agent of leprosy, detected in the synovial fluid.&lt;SEP&gt;Mycobacterium leprae is the causative bacterium of leprosy.&lt;SEP&gt;Mycobacterium Leprae is the causative agent of leprosy.</data>
  <data key="d3">chunk-aacfc6d7d3cc205cac72c8b8558bd157&lt;SEP&gt;chunk-94513ac90298144829224f0a47c2e282&lt;SEP&gt;chunk-f1eb426e138141a83709091f7abda682</data>
